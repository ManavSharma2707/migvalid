//@HLQ@E JOB (@ACCT@),'MIG DB2 LOAD',CLASS=@CLASS@,MSGCLASS=@MSGCLASS@,
//         NOTIFY=&SYSUID
//*-------------------------------------------------------------------
//* DB2LOAD - loads CUSTOMER_NEW (the modern system's table) from the
//* INSERT statements generated by gen_data.py. Safe to re-run: the
//* first statement empties the table. Only YOUR table is touched.
//*-------------------------------------------------------------------
//LOAD     EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DISP=SHR,DSN=@DB2LOAD@
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(@DB2SSID@)
  RUN PROGRAM(DSNTEP2) PLAN(@DB2PLAN@) LIB('@DB2RUN@')
  END
/*
//SYSIN    DD DSN=@HLQ@.MIG.SQL.CUSTLOAD,DISP=SHR
