//@HLQ@V JOB (@ACCT@),'MIGVALID',CLASS=@CLASS@,MSGCLASS=@MSGCLASS@,
//         NOTIFY=&SYSUID
//*-------------------------------------------------------------------
//* MIGVALID - Legacy-to-Modern Data Migration Validator
//*   CLEAN   remove outputs of an earlier run (job is re-runable)
//*   DEDUP   DFSORT  : sort source by key, SUM FIELDS=NONE drops dups
//*   SORTTGT DFSORT  : sort target extract by key
//*   COUNTS  ICETOOL : record counts of raw / dedup / target
//*   MATCH   COBOL   : match-merge, writes exceptions + control record
//*   REXXRUN REXX    : dedupe/sort exceptions, cross-check, decision
//*   AUDIT   DB2     : INSERT batch log + exceptions (DSNTEP2)
//*   LOGKSDS VSAM    : control record into the KSDS
//*   APPROVE/REJECT  : gate - RC 0/4 -> APPROVED, else REJECTED (GDG)
//*-------------------------------------------------------------------
//CLEAN    EXEC PGM=IEFBR14
//D01      DD DSN=@HLQ@.MIG.SRC.DEDUP,DISP=(MOD,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(1,1))
//D02      DD DSN=@HLQ@.MIG.TGT.SORTED,DISP=(MOD,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(1,1))
//D03      DD DSN=@HLQ@.MIG.CNT.RAW,DISP=(MOD,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(1,1))
//D04      DD DSN=@HLQ@.MIG.CNT.DEDUP,DISP=(MOD,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(1,1))
//D05      DD DSN=@HLQ@.MIG.CNT.TGT,DISP=(MOD,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(1,1))
//D06      DD DSN=@HLQ@.MIG.RECON.EXCEPT,DISP=(MOD,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(1,1))
//D07      DD DSN=@HLQ@.MIG.RECON.EXCSORT,DISP=(MOD,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(1,1))
//D08      DD DSN=@HLQ@.MIG.RECON.REPORT,DISP=(MOD,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(1,1))
//D09      DD DSN=@HLQ@.MIG.RECON.RESULT,DISP=(MOD,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(1,1))
//D10      DD DSN=@HLQ@.MIG.RECON.CTLREC,DISP=(MOD,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(1,1))
//D11      DD DSN=@HLQ@.MIG.RECON.SQL,DISP=(MOD,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(1,1))
//D12      DD DSN=@HLQ@.MIG.CTRL.OUT,DISP=(MOD,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(1,1))
//*
//*------------------ ASSIGNMENT 1 : DFSORT -------------------------
//DEDUP    EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=@HLQ@.MIG.SRC.EXTRACT,DISP=SHR
//SORTOUT  DD DSN=@HLQ@.MIG.SRC.DEDUP,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(15,15),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSIN    DD *
  OPTION EQUALS
  SORT FIELDS=(1,18,CH,A)
  SUM FIELDS=NONE
/*
//SORTTGT  EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=@HLQ@.MIG.TGT.EXTRACT,DISP=SHR
//SORTOUT  DD DSN=@HLQ@.MIG.TGT.SORTED,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(15,15),RLSE),
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
//SYSIN    DD *
  OPTION EQUALS
  SORT FIELDS=(1,18,CH,A)
/*
//COUNTS   EXEC PGM=ICETOOL
//TOOLMSG  DD SYSOUT=*
//DFSMSG   DD SYSOUT=*
//RAW      DD DSN=@HLQ@.MIG.SRC.EXTRACT,DISP=SHR
//DEDUP    DD DSN=@HLQ@.MIG.SRC.DEDUP,DISP=SHR
//TGT      DD DSN=@HLQ@.MIG.TGT.SORTED,DISP=SHR
//CNTRAW   DD DSN=@HLQ@.MIG.CNT.RAW,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//CNTDED   DD DSN=@HLQ@.MIG.CNT.DEDUP,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//CNTTGT   DD DSN=@HLQ@.MIG.CNT.TGT,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//TOOLIN   DD *
  COUNT FROM(RAW) WRITE(CNTRAW) TEXT('RAW=') DIGITS(10)
  COUNT FROM(DEDUP) WRITE(CNTDED) TEXT('DEDUP=') DIGITS(10)
  COUNT FROM(TGT) WRITE(CNTTGT) TEXT('TGT=') DIGITS(10)
/*
//*
//*------------------ ASSIGNMENT 2 : COBOL --------------------------
//MATCH    EXEC PGM=MIGMATCH
//STEPLIB  DD DSN=@HLQ@.MIG.LOAD,DISP=SHR
//SYSOUT   DD SYSOUT=*
//SRCIN    DD DSN=@HLQ@.MIG.SRC.DEDUP,DISP=SHR
//TGTIN    DD DSN=@HLQ@.MIG.TGT.SORTED,DISP=SHR
//EXCOUT   DD DSN=@HLQ@.MIG.RECON.EXCEPT,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(15,15),RLSE),
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
//CTLOUT   DD DSN=@HLQ@.MIG.CTRL.OUT,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//*
//*------------------ ASSIGNMENT 3 : REXX ---------------------------
//REXXRUN  EXEC PGM=IKJEFT01,DYNAMNBR=30
//SYSEXEC  DD DSN=@HLQ@.MIG.REXX,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//CNTRAW   DD DSN=@HLQ@.MIG.CNT.RAW,DISP=SHR
//CNTDED   DD DSN=@HLQ@.MIG.CNT.DEDUP,DISP=SHR
//CNTTGT   DD DSN=@HLQ@.MIG.CNT.TGT,DISP=SHR
//CTLIN    DD DSN=@HLQ@.MIG.CTRL.OUT,DISP=SHR
//EXCIN    DD DSN=@HLQ@.MIG.RECON.EXCEPT,DISP=SHR
//EXCSORT  DD DSN=@HLQ@.MIG.RECON.EXCSORT,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(15,15),RLSE),
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
//REPORT   DD DSN=@HLQ@.MIG.RECON.REPORT,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(15,15),RLSE),
//            DCB=(RECFM=FBA,LRECL=133,BLKSIZE=0)
//RESULT   DD DSN=@HLQ@.MIG.RECON.RESULT,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//CTLREC   DD DSN=@HLQ@.MIG.RECON.CTLREC,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(1,1),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=0)
//SQLOUT   DD DSN=@HLQ@.MIG.RECON.SQL,DISP=(NEW,CATLG,DELETE),
//            UNIT=@UNIT@,SPACE=(TRK,(30,30),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSTSIN  DD *
  %MIGREXX
/*
//*
//*------------------ DB2 AUDIT + VSAM CONTROL ----------------------
// IF (REXXRUN.RC < 16) THEN
//AUDIT    EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DISP=SHR,DSN=@DB2LOAD@
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(@DB2SSID@)
  RUN PROGRAM(DSNTEP2) PLAN(@DB2PLAN@) LIB('@DB2RUN@')
  END
/*
//SYSIN    DD DSN=@HLQ@.MIG.RECON.SQL,DISP=SHR
//LOGKSDS  EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//CTLIN    DD DSN=@HLQ@.MIG.RECON.CTLREC,DISP=SHR
//CTLKSDS  DD DSN=@HLQ@.MIG.CTRL.KSDS,DISP=SHR
//SYSIN    DD *
  REPRO INFILE(CTLIN) OUTFILE(CTLKSDS)
/*
// ENDIF
//*
//*------------------ ASSIGNMENT 4 : JCL GATE -----------------------
// IF (REXXRUN.RC <= 4) THEN
//APPROVE  EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=@HLQ@.MIG.SRC.DEDUP,DISP=SHR
//SYSUT2   DD DSN=@HLQ@.MIG.GATE.APPROVED(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=@UNIT@,
//            SPACE=(TRK,(15,15),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
// ELSE
//REJECT   EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=@HLQ@.MIG.RECON.EXCSORT,DISP=SHR
//SYSUT2   DD DSN=@HLQ@.MIG.GATE.REJECTED(+1),
//            DISP=(NEW,CATLG,DELETE),UNIT=@UNIT@,
//            SPACE=(TRK,(15,15),RLSE),
//            DCB=(RECFM=FB,LRECL=100,BLKSIZE=0)
// ENDIF
