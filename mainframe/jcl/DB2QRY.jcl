//@HLQ@Q JOB (@ACCT@),'MIG DB2 QUERY',CLASS=@CLASS@,MSGCLASS=@MSGCLASS@,
//         NOTIFY=&SYSUID
//*-------------------------------------------------------------------
//* DB2QRY - shows the audit trail kept in DB2 (read only queries)
//*-------------------------------------------------------------------
//QUERY    EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DISP=SHR,DSN=@DB2LOAD@
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(@DB2SSID@)
  RUN PROGRAM(DSNTEP2) PLAN(@DB2PLAN@) LIB('@DB2RUN@')
  END
/*
//SYSIN    DD *
SELECT BATCH_ID, DECISION, RC, SRC_RAW, DUPS, TGT_CNT, MATCHED,
       MISMATCH, MISSING, EXTRA
  FROM MIG_BATCH_LOG ORDER BY BATCH_ID DESC;
SELECT ERR_TYPE, COUNT(*) AS ROWS_PER_TYPE
  FROM MIG_EXCEPTION
 WHERE BATCH_ID = (SELECT MAX(BATCH_ID) FROM MIG_BATCH_LOG)
 GROUP BY ERR_TYPE;
SELECT COUNT(*) AS TARGET_ROWS FROM CUSTOMER_NEW;
/*
